generators := [ ( 1,34,47,80,66,18)( 2,55)( 3, 4,65,69,46,50)( 5,14,51,33,67,76)( 6,44)( 7,24)( 8,54,70)( 9,75,52,10,71,29)(12,41,74,22,28,60)(13,21,78,56,32,37)(15,81)(16,31)(17,61,79,45,36,26)(19,27,38,43,57,62)(20,48)(23,58,42)(25,68)(35,77)(39,64)(40,53)(49,63)(59,72), ( 1,66,19,75,10,57)( 2,48,11,39,20,30)( 4,76,59,32,33,15)( 5,31,78,23,40,69)( 6,13,67,68,50,42)( 7,62,45,16,80,54)( 8,44,34,61,63,27)( 9,26,53,52,70,81)(12,21)(14,49,60)(17,35,43,79,72,18)(22,58,77,41,51,24)(25,71,36)(28,65,37,56,46,74)(29,47)(55,64)(82,85,84,83)(87,88), (82,83)(84,85), ( 1,37)( 2,39)( 3,38)( 4,43)( 5,45)( 6,44)( 7,40)( 8,42)( 9,41)(10,28)(11,30)(12,29)(13,34)(14,36)(15,35)(16,31)(17,33)(18,32)(19,46)(20,48)(21,47)(22,52)(23,54)(24,53)(25,49)(26,51)(27,50)(55,64)(56,66)(57,65)(58,70)(59,72)(60,71)(61,67)(62,69)(63,68)(74,75)(76,79)(77,81)(78,80)(83,85,84) ],
