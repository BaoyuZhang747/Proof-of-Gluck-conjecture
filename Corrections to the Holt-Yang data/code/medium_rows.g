# Verification of the seventeen Holt--Yang rows for which the
# Yang--Vasil'ev--Vdovin fixed-point estimate is inconclusive.
#
# Put K=GF(q), where q=p^a.  For each row, M is the full normaliser in
# GammaL(eb,q) of the indicated core T.  The quasi-primitive structure theorem
# places every group under consideration in M: its normal cyclic subgroup U
# generates K over GF(p), so the group normalises K as well as T.  If 4 divides
# q-1, it also normalises the symplectic-type group generated by T and the
# unique scalar subgroup of order four.
#
# For each of the twenty-three row-and-core cases, the calculation constructs
# M/CT, enumerates its maximal solvable subgroups, identifies them with the
# recorded permutation groups up to conjugacy, and checks the recorded
# projective points.  In the five cases requiring descent, it reconstructs
# every subgroup allowed by the descent and checks the corresponding points.
# Thus all seventeen rows are verified afresh when this file is read.

SetPrintFormattingStatus("*stdout*", false);;

MediumRowsCheck := function(description, value, expected)
    if value <> expected then
        Error(description, ": expected ", expected, ", found ", value);
    fi;
end;;

MediumRowsPrimePower := function(e)
    local primes, r, n, value;
    primes := Set(FactorsInt(e));
    if Length(primes) <> 1 then
        Error("e is not a prime power: ", e);
    fi;
    r := primes[1];
    n := 0;
    value := e;
    while value > 1 do
        value := value / r;
        n := n + 1;
    od;
    return rec(r := r, n := n);
end;;

MediumRowsScalarMatrix := function(n, scalar, field)
    local matrix, i;
    matrix := NullMat(n, n, field);
    for i in [1 .. n] do
        matrix[i][i] := scalar;
    od;
    return matrix;
end;;

MediumRowsTensorFactorMatrix := function(field, numberOfFactors, factor,
                                         localMatrix)
    local tuples, dimension, matrix, row, tuple, columnEntry, value,
          imageTuple, position;
    tuples := Tuples([0, 1], numberOfFactors);
    dimension := Length(tuples);
    matrix := NullMat(dimension, dimension, field);
    for row in [1 .. dimension] do
        tuple := tuples[row];
        for columnEntry in [0, 1] do
            value := localMatrix[tuple[factor] + 1][columnEntry + 1];
            if not IsZero(value) then
                imageTuple := ShallowCopy(tuple);
                imageTuple[factor] := columnEntry;
                position := Position(tuples, imageTuple);
                matrix[row][position] := value;
            fi;
        od;
    od;
    return matrix;
end;;

MediumRowsDihedralPair := function(field)
    local zero, one;
    zero := Zero(field);
    one := One(field);
    return [
        [[one, zero], [zero, -one]],
        [[zero, one], [one, zero]]
    ];
end;;

MediumRowsQuaternionPair := function(field)
    local primeField, zero, one, c0, d0, c, d, first, second;
    primeField := PrimeField(field);
    zero := Zero(field);
    one := One(field);
    first := [[zero, one], [-one, zero]];
    for c0 in Elements(primeField) do
        for d0 in Elements(primeField) do
            c := one * c0;
            d := one * d0;
            if c^2 + d^2 = -one then
                second := [[c, d], [d, -c]];
                return [first, second];
            fi;
        od;
    od;
    Error("no quaternion pair over GF(", Size(field), ")");
end;;

MediumRowsBinaryExtraspecialGenerators := function(field, numberOfFactors,
                                                    kind)
    local generators, dihedral, quaternion, factor, pair;
    generators := [];
    dihedral := MediumRowsDihedralPair(field);
    if kind = "E-" then
        quaternion := MediumRowsQuaternionPair(field);
    fi;
    for factor in [1 .. numberOfFactors] do
        if kind = "E-" and factor = numberOfFactors then
            pair := quaternion;
        else
            pair := dihedral;
        fi;
        Add(generators, MediumRowsTensorFactorMatrix(
                            field, numberOfFactors, factor, pair[1]));
        Add(generators, MediumRowsTensorFactorMatrix(
                            field, numberOfFactors, factor, pair[2]));
    od;
    return generators;
end;;

MediumRowsSymplecticTypeGenerators := function(field, numberOfFactors)
    local generators, dimension, fourthRoot;
    generators := MediumRowsBinaryExtraspecialGenerators(
                      field, numberOfFactors, "E+");
    dimension := 2^numberOfFactors;
    fourthRoot := Z(Size(field))^((Size(field) - 1) / 4);
    Add(generators,
        MediumRowsScalarMatrix(dimension, fourthRoot, field));
    return generators;
end;;

MediumRowsExtraspecialCoresInS := function(field, numberOfFactors)
    local plusGenerators, minusGenerators, dimension, fourthRoot,
          fourthRootMatrix, position;
    plusGenerators := MediumRowsBinaryExtraspecialGenerators(
                          field, numberOfFactors, "E+");
    minusGenerators := ShallowCopy(plusGenerators);
    dimension := 2^numberOfFactors;
    fourthRoot := Z(Size(field))^((Size(field) - 1) / 4);
    fourthRootMatrix := MediumRowsScalarMatrix(
                            dimension, fourthRoot, field);
    for position in [Length(minusGenerators) - 1 ..
                     Length(minusGenerators)] do
        minusGenerators[position] :=
            fourthRootMatrix * minusGenerators[position];
    od;
    return [Group(plusGenerators), Group(minusGenerators)];
end;;

MediumRowsPauliGenerators := function(field, r, numberOfFactors)
    local omega, tuples, dimension, generators, factor, shift, clock,
          row, tuple, imageTuple, position;
    omega := Z(Size(field))^((Size(field) - 1) / r);
    tuples := Tuples([0 .. r - 1], numberOfFactors);
    dimension := Length(tuples);
    generators := [];
    for factor in [1 .. numberOfFactors] do
        shift := NullMat(dimension, dimension, field);
        clock := NullMat(dimension, dimension, field);
        for row in [1 .. dimension] do
            tuple := tuples[row];
            imageTuple := ShallowCopy(tuple);
            imageTuple[factor] := (imageTuple[factor] + 1) mod r;
            position := Position(tuples, imageTuple);
            shift[row][position] := One(field);
            clock[row][row] := omega^tuple[factor];
        od;
        Add(generators, shift);
        Add(generators, clock);
    od;
    return generators;
end;;

MediumRowsCoreGenerators := function(field, e, kind)
    local primePower;
    primePower := MediumRowsPrimePower(e);
    if primePower.r = 2 then
        if kind = "S" then
            return MediumRowsSymplecticTypeGenerators(
                       field, primePower.n);
        fi;
        return MediumRowsBinaryExtraspecialGenerators(
                   field, primePower.n, kind);
    fi;
    return MediumRowsPauliGenerators(
               field, primePower.r, primePower.n);
end;;

MediumRowsMultiplicationMatrix := function(extensionField, baseField,
                                            basis, scalar)
    local degree, matrix, row, column, coefficients;
    degree := Length(basis);
    matrix := NullMat(degree, degree, baseField);
    for row in [1 .. degree] do
        coefficients := Coefficients(basis, basis[row] * scalar);
        for column in [1 .. degree] do
            matrix[row][column] := coefficients[column];
        od;
    od;
    return matrix;
end;;

MediumRowsRestrictMatrix := function(extensionField, baseField, matrix)
    local basis, degree, dimension, result, row, column, block,
          blockRow, blockColumn;
    basis := Basis(extensionField);
    degree := Length(basis);
    dimension := Length(matrix);
    result := NullMat(dimension * degree, dimension * degree, baseField);
    for row in [1 .. dimension] do
        for column in [1 .. dimension] do
            block := MediumRowsMultiplicationMatrix(
                         extensionField, baseField, basis,
                         matrix[row][column]);
            for blockRow in [1 .. degree] do
                for blockColumn in [1 .. degree] do
                    result[(row - 1) * degree + blockRow]
                          [(column - 1) * degree + blockColumn] :=
                        block[blockRow][blockColumn];
                od;
            od;
        od;
    od;
    return result;
end;;

MediumRowsFrobeniusMatrix := function(extensionField, baseField)
    local basis, degree, matrix, row, column, coefficients;
    basis := Basis(extensionField);
    degree := Length(basis);
    matrix := NullMat(degree, degree, baseField);
    for row in [1 .. degree] do
        coefficients := Coefficients(
                            basis, basis[row]^Size(baseField));
        for column in [1 .. degree] do
            matrix[row][column] := coefficients[column];
        od;
    od;
    return matrix;
end;;

MediumRowsRepeatDiagonalBlock := function(block, copies, field)
    local size, matrix, copy, row, column;
    size := Length(block);
    matrix := NullMat(size * copies, size * copies, field);
    for copy in [1 .. copies] do
        for row in [1 .. size] do
            for column in [1 .. size] do
                matrix[(copy - 1) * size + row]
                      [(copy - 1) * size + column] := block[row][column];
            od;
        od;
    od;
    return matrix;
end;;

# These inflations realise A tensor I_b and I_e tensor B in the same basis.
MediumRowsInflateCoreMatrix := function(matrix, b, field)
    local e, result, i, j, k;
    e := Length(matrix);
    result := NullMat(e * b, e * b, field);
    for i in [1 .. e] do
        for j in [1 .. e] do
            for k in [1 .. b] do
                result[(i - 1) * b + k][(j - 1) * b + k] :=
                    matrix[i][j];
            od;
        od;
    od;
    return result;
end;;

MediumRowsInflateMultiplicityMatrix := function(matrix, e, b, field)
    local result, i, row, column;
    result := NullMat(e * b, e * b, field);
    for i in [1 .. e] do
        for row in [1 .. b] do
            for column in [1 .. b] do
                result[(i - 1) * b + row][(i - 1) * b + column] :=
                    matrix[row][column];
            od;
        od;
    od;
    return result;
end;;

# The matrices constructed here induce every automorphism of T which fixes
# T cap K^* pointwise.  Absolute irreducibility makes K^* the centraliser of
# T, so the asserted order proves that this is the full K-linear normaliser
# of the local core.
MediumRowsLocalNormaliser := function(row)
    local q, field, canonicalCoreGenerators, canonicalCore, module,
          scalarMatrix, scalarGroup, scalarIntersection, scalarInCore,
          pcIsomorphism, pcCore, pcScalar, automorphisms,
          fixedAutomorphisms, pcGenerators, coreGenerators, sourceModule,
          lifts, automorphism, imageMatrices, imageModule, intertwiner, i,
          normaliser, extraspecialCores, extraspecialOrder, fourthRootMatrix;

    q := row.p^row.a;
    field := GF(q);
    canonicalCoreGenerators := MediumRowsCoreGenerators(
                                   field, row.e, row.kind);
    canonicalCore := Group(canonicalCoreGenerators);
    module := GModuleByMats(canonicalCoreGenerators, field);
    MediumRowsCheck(Concatenation("absolute irreducibility in row ",
                                  String(row.row), row.kind),
                    MTX.IsAbsolutelyIrreducible(module), true);
    MediumRowsCheck(Concatenation("core order in row ",
                                  String(row.row), row.kind),
                    Size(canonicalCore), row.coreOrder);
    if row.kind = "E3" then
        # Quasi-primitivity excludes the other extraspecial 3-group, whose
        # exponent is 9.  In that group the elements of order dividing 3
        # form a characteristic subgroup of index 3 with noncyclic centre.
        # This subgroup is normal in G and must act homogeneously.  Its action
        # is faithful, so one irreducible constituent would have to be
        # faithful; Schur's lemma would then make its centre cyclic, a
        # contradiction.  Thus this is the unique required odd-core branch.
        MediumRowsCheck(Concatenation("core exponent in row ",
                                      String(row.row), row.kind),
                        Exponent(canonicalCore), 3);
    else
        MediumRowsCheck(Concatenation("core exponent in row ",
                                      String(row.row), row.kind),
                        Exponent(canonicalCore), 4);
        if row.kind = "E+" then
            MediumRowsCheck(Concatenation("plus type in row ",
                                          String(row.row)),
                Number(Elements(canonicalCore),
                       x -> x^2 = One(canonicalCore)),
                row.e^2 + row.e);
        elif row.kind = "E-" then
            MediumRowsCheck(Concatenation("minus type in row ",
                                          String(row.row)),
                Number(Elements(canonicalCore),
                       x -> x^2 = One(canonicalCore)),
                row.e^2 - row.e);
        fi;
    fi;

    scalarMatrix := MediumRowsScalarMatrix(row.e, Z(q), field);
    scalarGroup := Group([scalarMatrix]);
    scalarIntersection := Intersection(canonicalCore, scalarGroup);
    MediumRowsCheck(Concatenation("scalar intersection in row ",
                                  String(row.row), row.kind),
                    Size(scalarIntersection),
                    row.scalarIntersectionOrder);
    MediumRowsCheck(Concatenation("centre of the core in row ",
                                  String(row.row), row.kind),
                    Centre(canonicalCore), scalarIntersection);

    if row.kind = "S" then
        extraspecialCores := MediumRowsExtraspecialCoresInS(
            field, MediumRowsPrimePower(row.e).n);
        extraspecialOrder := 2 * row.e^2;
        MediumRowsCheck(Concatenation(
            "orders of the extraspecial cores in row ",
            String(row.row)), List(extraspecialCores, Size),
            [extraspecialOrder, extraspecialOrder]);
        MediumRowsCheck(Concatenation(
            "types of the extraspecial cores in row ",
            String(row.row)),
            List(extraspecialCores, group ->
                Number(Elements(group), x -> x^2 = One(group))),
            [row.e^2 + row.e, row.e^2 - row.e]);
        MediumRowsCheck(Concatenation(
            "extraspecial cores lie in S in row ", String(row.row)),
            ForAll(extraspecialCores,
                   group -> IsSubgroup(canonicalCore, group)), true);
        fourthRootMatrix := MediumRowsScalarMatrix(
            row.e, Z(q)^((q - 1) / 4), field);
        MediumRowsCheck(Concatenation(
            "each extraspecial core together with C4 is S in row ",
            String(row.row)),
            ForAll(extraspecialCores, group ->
                Group(Concatenation(GeneratorsOfGroup(group),
                                    [fourthRootMatrix])) = canonicalCore),
            true);
    fi;

    scalarInCore := First(Elements(scalarIntersection),
        x -> Order(x) = row.scalarIntersectionOrder);
    if scalarInCore = fail then
        Error("the scalar intersection has no generator of the required order");
    fi;
    pcIsomorphism := IsomorphismPcGroup(canonicalCore);
    pcCore := Image(pcIsomorphism);
    pcScalar := Image(pcIsomorphism, scalarInCore);
    automorphisms := AutomorphismGroup(pcCore);
    fixedAutomorphisms := Stabilizer(
                              automorphisms, pcScalar, OnPoints);
    MediumRowsCheck(Concatenation(
        "automorphisms fixing the scalar centre in row ",
        String(row.row), row.kind),
        Size(fixedAutomorphisms), row.fixedAutomorphismOrder);
    MediumRowsCheck(Concatenation(
        "fixed-centre generators in row ", String(row.row), row.kind),
        ForAll(GeneratorsOfGroup(fixedAutomorphisms),
               automorphism ->
                   Image(automorphism, pcScalar) = pcScalar), true);

    pcGenerators := GeneratorsOfGroup(pcCore);
    coreGenerators := List(pcGenerators,
        x -> PreImagesRepresentative(pcIsomorphism, x));
    MediumRowsCheck(Concatenation("pc generators recover the core in row ",
                                  String(row.row), row.kind),
                    Group(coreGenerators), canonicalCore);
    sourceModule := GModuleByMats(coreGenerators, field);
    lifts := [];
    for automorphism in GeneratorsOfGroup(fixedAutomorphisms) do
        imageMatrices := List(pcGenerators, x ->
            PreImagesRepresentative(pcIsomorphism,
                                    Image(automorphism, x)));
        imageModule := GModuleByMats(imageMatrices, field);
        intertwiner := MTX.IsomorphismModules(sourceModule, imageModule);
        if intertwiner = fail or RankMat(intertwiner) <> row.e then
            Error("an automorphism did not lift in row ", row.row,
                  row.kind);
        fi;
        MediumRowsCheck(Concatenation(
            "intertwining equations in row ", String(row.row), row.kind),
            ForAll([1 .. Length(coreGenerators)], i ->
                intertwiner^-1 * coreGenerators[i] * intertwiner
                    = imageMatrices[i]), true);
        Add(lifts, intertwiner);
    od;

    normaliser := Group(Concatenation(
        coreGenerators, lifts, [scalarMatrix]));
    MediumRowsCheck(Concatenation("local normaliser order in row ",
                                  String(row.row), row.kind),
                    Size(normaliser),
                    (q - 1) * row.fixedAutomorphismOrder);
    MediumRowsCheck(Concatenation("core normal in local normaliser in row ",
                                  String(row.row), row.kind),
                    IsNormal(normaliser, canonicalCore), true);

    return rec(
        field := field,
        core := canonicalCore,
        coreGenerators := coreGenerators,
        scalarMatrix := scalarMatrix,
        scalarGroup := scalarGroup,
        normaliser := normaliser,
        normaliserGenerators := Concatenation(
            coreGenerators, lifts, [scalarMatrix]));
end;;

MediumRowsCanonicalKVector := function(vector)
    local first, scalar;
    first := PositionProperty(vector, x -> not IsZero(x));
    if first = fail then
        Error("the zero vector does not define a projective point");
    fi;
    scalar := vector[first]^-1;
    return List(vector, x -> scalar * x);
end;;

MediumRowsProjectivePoints := function(dimension, field)
    local points, first, tailLength, number, value, digit, tail, coordinates;
    points := [];
    for first in [1 .. dimension] do
        tailLength := dimension - first;
        for number in [0 .. Size(field)^tailLength - 1] do
            value := number;
            tail := [];
            while Length(tail) < tailLength do
                digit := value mod Size(field);
                if digit = 0 then
                    Add(tail, Zero(field));
                else
                    Add(tail, Z(Size(field))^(digit - 1));
                fi;
                value := QuoInt(value, Size(field));
            od;
            coordinates := Concatenation(
                ListWithIdenticalEntries(first - 1, Zero(field)),
                [One(field)], tail);
            Add(points, coordinates);
        od;
    od;
    MediumRowsCheck("number of projective points", Length(points),
                    (Size(field)^dimension - 1) / (Size(field) - 1));
    MediumRowsCheck("distinct projective points", Length(Set(points)),
                    Length(points));
    return points;
end;;

MediumRowsProjectiveMatrixPermutation := function(points, matrix)
    local images;
    images := List(points, vector ->
        Position(points, MediumRowsCanonicalKVector(vector * matrix)));
    if fail in images then
        Error("a matrix did not permute the projective points");
    fi;
    return PermList(images);
end;;

MediumRowsProjectiveFrobeniusPermutation := function(points, p)
    local images;
    images := List(points, vector ->
        Position(points, MediumRowsCanonicalKVector(
            List(vector, x -> x^p))));
    if fail in images then
        Error("Frobenius did not permute the projective points");
    fi;
    return PermList(images);
end;;

MediumRowsCoreCosetPermutation := function(cosets, matrix)
    local representatives, images, image, position;
    representatives := List(cosets, Representative);
    images := [];
    for image in List(representatives, x -> x^matrix) do
        position := PositionProperty(cosets, coset -> image in coset);
        if position = fail then
            Error("a normaliser generator did not permute the core cosets");
        fi;
        Add(images, position);
    od;
    return PermList(images);
end;;

MediumRowsFieldPermutation := function(a)
    if a = 1 then
        return PermList([1]);
    fi;
    return PermList(Concatenation([2 .. a], [1]));
end;;

MediumRowsCombinedPermutationOnDomains := function(corePermutation,
                                                    coreDegree,
                                                    multiplicityPermutation,
                                                    multiplicityDegree,
                                                    fieldPermutation,
                                                    fieldDegree)
    local images, i;
    images := [];
    for i in [1 .. coreDegree] do
        Add(images, i^corePermutation);
    od;
    for i in [1 .. multiplicityDegree] do
        Add(images, coreDegree + (i^multiplicityPermutation));
    od;
    for i in [1 .. fieldDegree] do
        Add(images, coreDegree + multiplicityDegree +
                    (i^fieldPermutation));
    od;
    return PermList(images);
end;;

MediumRowsSemilinearNormaliser := function(row)
    local q, field, baseField, localData, localGeneratorsK, localFactorK,
          generalLinear, multiplicityGenerators, multiplicityGeneratorsK,
          multiplicityFactorK, linearK, coreGeneratorsK, coreK,
          scalarMatrixK, scalarGroupK, coreModule, endomorphisms,
          localGenerators, multiplicityGeneratorsF, sourceGenerators,
          linearGroup, coreGenerators, core, scalarMatrix, scalarGroup,
          scalarIntersection, ct, frobenius, semilinear,
          expectedLinearOrder, expectedSemilinearOrder, expectedCTOrder,
          coreCosets, coreDegree, multiplicityPoints, multiplicityDegree,
          fieldDegree, identityCore, identityMultiplicity, identityField,
          fieldCycle, quotientImages, matrix, originalMatrix,
          corePermutation, multiplicityPermutation,
          quotient, quotientMap, expectedQuotientOrder, i,
          localImageCount, multiplicityImageCount, localQuotientFactor,
          multiplicityQuotientFactor, linearQuotientFactor;

    q := row.p^row.a;
    field := GF(q);
    baseField := GF(row.p);
    localData := MediumRowsLocalNormaliser(row);

    localGeneratorsK := List(localData.normaliserGenerators,
        matrix -> MediumRowsInflateCoreMatrix(matrix, row.b, field));
    localFactorK := Group(localGeneratorsK);
    generalLinear := GL(row.b, q);
    multiplicityGenerators := GeneratorsOfGroup(generalLinear);
    multiplicityGeneratorsK := List(multiplicityGenerators,
        matrix -> MediumRowsInflateMultiplicityMatrix(
                      matrix, row.e, row.b, field));
    multiplicityFactorK := Group(multiplicityGeneratorsK);
    linearK := Group(Concatenation(localGeneratorsK,
                                   multiplicityGeneratorsK));
    coreGeneratorsK := List(localData.coreGenerators,
        matrix -> MediumRowsInflateCoreMatrix(matrix, row.b, field));
    coreK := Group(coreGeneratorsK);
    scalarMatrixK := MediumRowsScalarMatrix(
                         row.e * row.b, Z(q), field);
    scalarGroupK := Group([scalarMatrixK]);

    MediumRowsCheck(Concatenation("inflated core order in row ",
                                  String(row.row), row.kind),
                    Size(coreK), row.coreOrder);
    MediumRowsCheck(Concatenation("scalar group over K in row ",
                                  String(row.row), row.kind),
                    Size(scalarGroupK), q - 1);
    MediumRowsCheck(Concatenation("scalar intersection over K in row ",
                                  String(row.row), row.kind),
                    Size(Intersection(coreK, scalarGroupK)),
                    row.scalarIntersectionOrder);

    MediumRowsCheck(Concatenation("inflated local factor in row ",
                                  String(row.row), row.kind),
                    Size(localFactorK), Size(localData.normaliser));
    MediumRowsCheck(Concatenation("multiplicity factor in row ",
                                  String(row.row), row.kind),
                    Size(multiplicityFactorK), Size(generalLinear));
    MediumRowsCheck(Concatenation("intersection of the two factors in row ",
                                  String(row.row), row.kind),
                    Size(Intersection(localFactorK, multiplicityFactorK)),
                    q - 1);
    MediumRowsCheck(Concatenation("the two factors commute in row ",
                                  String(row.row), row.kind),
        ForAll(localGeneratorsK, x ->
            ForAll(multiplicityGeneratorsK, y -> x * y = y * x)), true);

    expectedLinearOrder := row.fixedAutomorphismOrder * Size(generalLinear);
    MediumRowsCheck(Concatenation("full K-linear normaliser order in row ",
                                  String(row.row), row.kind),
                    Size(linearK), expectedLinearOrder);
    coreModule := GModuleByMats(coreGeneratorsK, field);
    endomorphisms := MTX.BasisModuleEndomorphisms(coreModule);
    MediumRowsCheck(Concatenation(
        "endomorphism-algebra dimension of the repeated core in row ",
        String(row.row), row.kind), Length(endomorphisms), row.b^2);

    # The endomorphism algebra is Mat_b(K).  Thus its invertible elements are
    # the displayed GL(b,q), and any linear normaliser, after multiplication
    # by a displayed lift of its automorphism of T, lies in this centraliser.
    # The product-order check above therefore proves that linearK is the full
    # K-linear normaliser of the repeated core.

    localGenerators := List(localGeneratorsK,
        matrix -> MediumRowsRestrictMatrix(field, baseField, matrix));
    multiplicityGeneratorsF := List(multiplicityGeneratorsK,
        matrix -> MediumRowsRestrictMatrix(field, baseField, matrix));
    coreGenerators := List(coreGeneratorsK,
        matrix -> MediumRowsRestrictMatrix(field, baseField, matrix));
    MediumRowsCheck(Concatenation("prime-field dimension in row ",
                                  String(row.row), row.kind),
                    Length(coreGenerators[1]),
                    row.e * row.a * row.b);
    core := Group(coreGenerators);
    scalarMatrix := MediumRowsRestrictMatrix(
                        field, baseField, scalarMatrixK);
    scalarGroup := Group([scalarMatrix]);
    linearGroup := Group(Concatenation(localGenerators,
                                       multiplicityGeneratorsF));
    frobenius := MediumRowsRepeatDiagonalBlock(
        MediumRowsFrobeniusMatrix(field, baseField),
        row.e * row.b, baseField);
    sourceGenerators := Concatenation(localGenerators,
                                      multiplicityGeneratorsF);
    if row.a > 1 then
        Add(sourceGenerators, frobenius);
    fi;
    semilinear := Group(sourceGenerators);

    # We now pass from the K-linear normaliser to the normaliser in
    # GammaL(eb,q).  The displayed Frobenius matrix induces a generator of
    # Gal(K/GF(p)), while the kernel of this field action is the full
    # K-linear normaliser constructed above.  The following order and
    # normality checks therefore prove that semilinear is the full normaliser
    # of T in GammaL(eb,q).

    MediumRowsCheck(Concatenation("restriction of the linear normaliser in row ",
                                  String(row.row), row.kind),
                    Size(linearGroup), expectedLinearOrder);
    MediumRowsCheck(Concatenation("restricted core order in row ",
                                  String(row.row), row.kind),
                    Size(core), row.coreOrder);
    MediumRowsCheck(Concatenation("restricted scalar group in row ",
                                  String(row.row), row.kind),
                    Size(scalarGroup), q - 1);
    MediumRowsCheck(Concatenation("Frobenius order in row ",
                                  String(row.row), row.kind),
                    Order(frobenius), row.a);
    expectedSemilinearOrder := row.a * expectedLinearOrder;
    MediumRowsCheck(Concatenation("semilinear normaliser order in row ",
                                  String(row.row), row.kind),
                    Size(semilinear), expectedSemilinearOrder);
    MediumRowsCheck(Concatenation("core normal in M in row ",
                                  String(row.row), row.kind),
                    IsNormal(semilinear, core), true);
    MediumRowsCheck(Concatenation("scalars normal in M in row ",
                                  String(row.row), row.kind),
                    IsNormal(semilinear, scalarGroup), true);
    MediumRowsCheck(Concatenation("linear normaliser normal in M in row ",
                                  String(row.row), row.kind),
                    IsNormal(semilinear, linearGroup), true);

    scalarIntersection := Intersection(core, scalarGroup);
    MediumRowsCheck(Concatenation("restricted scalar intersection in row ",
                                  String(row.row), row.kind),
                    Size(scalarIntersection),
                    row.scalarIntersectionOrder);
    MediumRowsCheck(Concatenation("restricted core centre in row ",
                                  String(row.row), row.kind),
                    Centre(core), scalarIntersection);
    MediumRowsCheck(Concatenation("T/(T cap C) is abelian in row ",
                                  String(row.row), row.kind),
                    IsSubgroup(scalarIntersection,
                               DerivedSubgroup(core)), true);
    ct := Group(Concatenation(coreGenerators, [scalarMatrix]));
    expectedCTOrder := row.coreOrder * (q - 1)
                       / row.scalarIntersectionOrder;
    MediumRowsCheck(Concatenation("order of CT in row ",
                                  String(row.row), row.kind),
                    Size(ct), expectedCTOrder);
    MediumRowsCheck(Concatenation("CT normal in M in row ",
                                  String(row.row), row.kind),
                    IsNormal(semilinear, ct), true);

    # A small faithful action of M/CT is obtained from three actions on a
    # disjoint union.  The first is conjugation on T/(T cap C), the second is
    # the projective multiplicity action, and the third records the field
    # automorphism.  The last component is essential when Frobenius acts
    # trivially on the first two components.
    coreCosets := RightCosets(core, scalarIntersection);
    # The cosets are labelled by their complete sets of matrices.  This
    # makes the quotient action independent of the generating set returned
    # for the same matrix group in a fresh GAP session.
    SortBy(coreCosets, coset -> Set(AsList(coset)));
    coreDegree := Length(coreCosets);
    MediumRowsCheck(Concatenation("core quotient degree in row ",
                                  String(row.row), row.kind),
                    coreDegree,
                    row.coreOrder / row.scalarIntersectionOrder);
    multiplicityPoints := MediumRowsProjectivePoints(row.b, field);
    multiplicityDegree := Length(multiplicityPoints);
    fieldDegree := row.a;
    MediumRowsCheck(Concatenation("degree of the quotient action in row ",
                                  String(row.row), row.kind),
                    coreDegree + multiplicityDegree + fieldDegree <= 88,
                    true);
    identityCore := PermList([1 .. coreDegree]);
    identityMultiplicity := PermList([1 .. multiplicityDegree]);
    identityField := PermList([1 .. fieldDegree]);
    fieldCycle := MediumRowsFieldPermutation(row.a);
    quotientImages := [];

    for matrix in localGenerators do
        corePermutation := MediumRowsCoreCosetPermutation(
                               coreCosets, matrix);
        Add(quotientImages, MediumRowsCombinedPermutationOnDomains(
            corePermutation, coreDegree,
            identityMultiplicity, multiplicityDegree,
            identityField, fieldDegree));
    od;
    for i in [1 .. Length(multiplicityGeneratorsF)] do
        matrix := multiplicityGeneratorsF[i];
        corePermutation := MediumRowsCoreCosetPermutation(
                               coreCosets, matrix);
        MediumRowsCheck(Concatenation(
            "multiplicity factor centralises the core quotient in row ",
            String(row.row), row.kind), corePermutation, identityCore);
        originalMatrix := multiplicityGenerators[i];
        multiplicityPermutation :=
            MediumRowsProjectiveMatrixPermutation(
                multiplicityPoints, originalMatrix);
        Add(quotientImages, MediumRowsCombinedPermutationOnDomains(
            identityCore, coreDegree,
            multiplicityPermutation, multiplicityDegree,
            identityField, fieldDegree));
    od;
    if row.a > 1 then
        corePermutation := MediumRowsCoreCosetPermutation(
                               coreCosets, frobenius);
        multiplicityPermutation :=
            MediumRowsProjectiveFrobeniusPermutation(
                multiplicityPoints, row.p);
        Add(quotientImages, MediumRowsCombinedPermutationOnDomains(
            corePermutation, coreDegree,
            multiplicityPermutation, multiplicityDegree,
            fieldCycle, fieldDegree));
    fi;

    localImageCount := Length(localGenerators);
    multiplicityImageCount := Length(multiplicityGeneratorsF);
    localQuotientFactor := Group(
        quotientImages{[1 .. localImageCount]});
    multiplicityQuotientFactor := Group(
        quotientImages{[localImageCount + 1 ..
                         localImageCount + multiplicityImageCount]});
    linearQuotientFactor := Group(
        quotientImages{[1 ..
                         localImageCount + multiplicityImageCount]});
    MediumRowsCheck(Concatenation("classical factor of M/CT in row ",
                                  String(row.row), row.kind),
                    Size(localQuotientFactor),
                    row.classicalQuotientOrder);
    MediumRowsCheck(Concatenation("projective multiplicity factor in row ",
                                  String(row.row), row.kind),
                    Size(multiplicityQuotientFactor),
                    row.projectiveMultiplicityOrder);
    MediumRowsCheck(Concatenation("intersection of quotient factors in row ",
                                  String(row.row), row.kind),
                    Size(Intersection(localQuotientFactor,
                                      multiplicityQuotientFactor)), 1);
    MediumRowsCheck(Concatenation("quotient factors commute in row ",
                                  String(row.row), row.kind),
        ForAll(GeneratorsOfGroup(localQuotientFactor), x ->
            ForAll(GeneratorsOfGroup(multiplicityQuotientFactor), y ->
                x * y = y * x)), true);
    MediumRowsCheck(Concatenation("linear part of M/CT in row ",
                                  String(row.row), row.kind),
                    Size(linearQuotientFactor),
                    row.classicalQuotientOrder
                    * row.projectiveMultiplicityOrder);

    quotient := Group(quotientImages);
    MediumRowsCheck(Concatenation("linear quotient normal in M/CT in row ",
                                  String(row.row), row.kind),
                    IsNormal(quotient, linearQuotientFactor), true);
    MediumRowsCheck(Concatenation("field index in M/CT in row ",
                                  String(row.row), row.kind),
                    Index(quotient, linearQuotientFactor), row.a);
    quotientMap := GroupHomomorphismByImages(
                       semilinear, quotient,
                       sourceGenerators, quotientImages);
    if quotientMap = fail then
        Error("the combined quotient action is not a homomorphism in row ",
              row.row, row.kind);
    fi;
    MediumRowsCheck(Concatenation("combined action is a homomorphism in row ",
                                  String(row.row), row.kind),
                    IsGroupHomomorphism(quotientMap), true);
    MediumRowsCheck(Concatenation("combined action is onto in row ",
                                  String(row.row), row.kind),
                    Image(quotientMap), quotient);
    MediumRowsCheck(Concatenation("kernel of the combined action in row ",
                                  String(row.row), row.kind),
                    Kernel(quotientMap), ct);
    expectedQuotientOrder := expectedSemilinearOrder / expectedCTOrder;
    MediumRowsCheck(Concatenation("formula for M/CT in row ",
                                  String(row.row), row.kind),
                    expectedQuotientOrder, row.quotientOrder);
    MediumRowsCheck(Concatenation("order of the combined quotient in row ",
                                  String(row.row), row.kind),
                    Size(quotient), row.quotientOrder);
    MediumRowsCheck(Concatenation("index of CT in M in row ",
                                  String(row.row), row.kind),
                    Index(semilinear, ct), Size(quotient));

    return rec(
        row := row,
        extensionField := field,
        extensionBasis := Basis(field),
        baseField := baseField,
        core := core,
        coreCosets := coreCosets,
        scalarGroup := scalarGroup,
        scalarIntersection := scalarIntersection,
        ct := ct,
        linearGroup := linearGroup,
        semilinear := semilinear,
        quotient := quotient,
        quotientMap := quotientMap,
        linearQuotientFactor := linearQuotientFactor,
        quotientActionDegree :=
            coreDegree + multiplicityDegree + fieldDegree,
        multiplicityPoints := multiplicityPoints);
end;;

# GAP defines MaximalSolvableSubgroups as the conjugacy-class representatives
# of the subgroups maximal among the solvable subgroups of the given group.
MediumRowsMaximalSolvableQuotientGroups := function(quotient)
    local groups;
    groups := MaximalSolvableSubgroups(quotient);
    if Length(groups) = 0 then
        Error("GAP returned no maximal solvable subgroup");
    fi;
    MediumRowsCheck("maximal-solvable groups lie in the quotient",
        ForAll(groups, group -> IsSubgroup(quotient, group)), true);
    MediumRowsCheck("all maximal-solvable representatives are solvable",
        ForAll(groups, IsSolvableGroup), true);
    return groups;
end;;

# If G is a solvable subgroup of M, then GCT/CT is contained in a conjugate
# of one of the groups returned above.  Its inverse image H is solvable and
# contains a conjugate of G.  A reducible H cannot contain an irreducible G;
# consequently it is enough to find a regular vector for each irreducible H.
MediumRowsPreimagesOfQuotientGroups := function(data, quotientGroups)
    local preimages, i;
    preimages := List(quotientGroups,
                      group -> PreImage(data.quotientMap, group));
    MediumRowsCheck("all maximal-solvable inverse images are solvable",
                    ForAll(preimages, IsSolvableGroup), true);
    MediumRowsCheck("each inverse image contains CT",
        ForAll(preimages, group -> IsSubgroup(group, data.ct)), true);
    MediumRowsCheck("orders of maximal-solvable inverse images",
        ForAll([1 .. Length(preimages)], i ->
            Size(preimages[i]) = Size(data.ct) * Size(quotientGroups[i])),
        true);
    MediumRowsCheck("images of maximal-solvable inverse images",
        ForAll([1 .. Length(preimages)], i ->
            Image(data.quotientMap, preimages[i]) = quotientGroups[i]),
        true);
    return rec(quotientGroups := quotientGroups,
               preimages := preimages);
end;;

MediumRowsMakeScopeRecords := function(scopes)
    local records, i;
    records := [];
    for i in [1 .. Length(scopes.preimages)] do
        Add(records,
            rec(quotientGroup := scopes.quotientGroups[i],
                preimage := scopes.preimages[i],
                quotientOrder := Size(scopes.quotientGroups[i])));
    od;
    return records;
end;;

MediumRowsScopeIsIrreducible := function(scope, baseField)
    return MTX.IsIrreducible(GModuleByMats(
        GeneratorsOfGroup(scope.preimage), baseField));
end;;

MediumRowsReferenceScopes := function(rowData, data)
    local quotientGroups, entry, group, generators, scopes, records, i;
    MediumRowsCheck("degree of the recorded quotient action",
                    rowData.actionDegree,
                    data.quotientActionDegree);
    quotientGroups := [];
    for entry in rowData.groups do
        generators := ShallowCopy(entry.generators);
        MediumRowsCheck("recorded permutations lie in M/CT",
            ForAll(generators, generator -> generator in data.quotient),
            true);
        if Length(generators) = 0 then
            group := TrivialSubgroup(data.quotient);
        else
            group := Group(generators);
        fi;
        MediumRowsCheck("recorded subgroup lies in M/CT",
                        IsSubgroup(data.quotient, group), true);
        MediumRowsCheck("order of a recorded quotient subgroup",
                        Size(group), entry.order);
        MediumRowsCheck("recorded quotient subgroup is solvable",
                        IsSolvableGroup(group), true);
        Add(quotientGroups, group);
    od;
    scopes := MediumRowsPreimagesOfQuotientGroups(data, quotientGroups);
    records := MediumRowsMakeScopeRecords(scopes);
    for i in [1 .. Length(records)] do
        records[i].recordedEntry := rowData.groups[i];
    od;
    return records;
end;;

MediumRowsCheckConjugacyBijection := function(quotient, references, fresh)
    local table, reference, current, row, column;
    MediumRowsCheck("number of recorded maximal-solvable classes",
                    Length(references), Length(fresh));
    table := List(references, reference ->
        List(fresh, current ->
            Size(reference) = Size(current) and
            IsConjugate(quotient, reference, current)));
    for row in table do
        MediumRowsCheck("a recorded subgroup has one fresh conjugate",
                        Number(row, value -> value), 1);
    od;
    for column in [1 .. Length(fresh)] do
        MediumRowsCheck("a fresh subgroup has one recorded conjugate",
            Number(table, row -> row[column]), 1);
    od;
end;;

MediumRowsCoreCosetPosition := function(coreCosets, element)
    local position;
    position := PositionProperty(coreCosets, coset -> element in coset);
    if position = fail then
        Error("an element did not lie in a recorded core coset");
    fi;
    return position;
end;;

# The canonical coset labels are given coordinates in T/Z(T).  At each
# stage the first coset outside the span already constructed is chosen for
# the next basis vector.
MediumRowsCoreQuotientCoordinates := function(data)
    local primePower, r, dimension, field, coreCosets, coordinates,
          identityPosition, basisPositions, spanPositions, candidate,
          basisNumber, oldPositions, oldPosition, exponent, element,
          position, vector;
    primePower := MediumRowsPrimePower(data.row.e);
    r := primePower.r;
    dimension := 2 * primePower.n;
    field := GF(r);
    coreCosets := data.coreCosets;
    MediumRowsCheck("order of the elementary abelian core quotient",
                    Length(coreCosets), r^dimension);
    coordinates := ListWithIdenticalEntries(Length(coreCosets), fail);
    identityPosition := MediumRowsCoreCosetPosition(
        coreCosets, One(data.core));
    coordinates[identityPosition] :=
        ListWithIdenticalEntries(dimension, Zero(field));
    basisPositions := [];
    spanPositions := [identityPosition];

    for candidate in [1 .. Length(coreCosets)] do
        if coordinates[candidate] = fail then
            Add(basisPositions, candidate);
            basisNumber := Length(basisPositions);
            oldPositions := ShallowCopy(spanPositions);
            for exponent in [1 .. r - 1] do
                for oldPosition in oldPositions do
                    element := Representative(coreCosets[oldPosition])
                               * Representative(coreCosets[candidate])
                                 ^ exponent;
                    position := MediumRowsCoreCosetPosition(
                                    coreCosets, element);
                    if coordinates[position] <> fail then
                        Error("the core-quotient coordinate construction ",
                              "repeated a coset");
                    fi;
                    vector := ShallowCopy(coordinates[oldPosition]);
                    vector[basisNumber] := exponent * One(field);
                    coordinates[position] := vector;
                    Add(spanPositions, position);
                od;
            od;
        fi;
    od;

    MediumRowsCheck("dimension of the elementary abelian core quotient",
                    Length(basisPositions), dimension);
    MediumRowsCheck("all core cosets have coordinates",
                    ForAll(coordinates, vector -> vector <> fail), true);
    MediumRowsCheck("distinct core-quotient coordinates",
                    Length(Set(coordinates)), Length(coordinates));
    return rec(field := field,
               dimension := dimension,
               coordinates := coordinates,
               basisPositions := basisPositions);
end;;

MediumRowsCoreQuotientMatrixGroup := function(quotientGroup, data,
                                               coordinateData)
    local sourceGenerators, matrices, generator, matrix, position,
          coordinates, moduleMatrices, matrixGroup, actionMap;
    sourceGenerators := GeneratorsOfGroup(quotientGroup);
    matrices := [];
    coordinates := coordinateData.coordinates;
    for generator in sourceGenerators do
        matrix := List(coordinateData.basisPositions,
            position -> ShallowCopy(coordinates[position^generator]));
        MediumRowsCheck("rank of an induced core-quotient matrix",
                        RankMat(matrix), coordinateData.dimension);
        MediumRowsCheck("linearity on every element of the core quotient",
            ForAll([1 .. Length(coordinates)], position ->
                coordinates[position] * matrix
                    = coordinates[position^generator]), true);
        Add(matrices, matrix);
    od;
    moduleMatrices := ShallowCopy(matrices);
    if Length(moduleMatrices) = 0 then
        moduleMatrices := [IdentityMat(coordinateData.dimension,
                                       coordinateData.field)];
    fi;
    matrixGroup := Group(moduleMatrices);
    actionMap := GroupHomomorphismByImages(
        quotientGroup, matrixGroup, sourceGenerators, matrices);
    if actionMap = fail then
        Error("the induced action on the core quotient is not a homomorphism");
    fi;
    MediumRowsCheck("induced core-quotient action is a homomorphism",
                    IsGroupHomomorphism(actionMap), true);
    MediumRowsCheck("image of the induced core-quotient action",
                    Image(actionMap), matrixGroup);
    return rec(group := matrixGroup,
               map := actionMap,
               moduleMatrices := moduleMatrices);
end;;

MediumRowsFaithfulCompletelyReducibleOnCoreQuotient :=
function(quotientGroup, data, coordinateData)
    local representation, module, socle;
    representation := MediumRowsCoreQuotientMatrixGroup(
                          quotientGroup, data, coordinateData);
    if Kernel(representation.map) <> TrivialSubgroup(quotientGroup) then
        return false;
    fi;
    module := GModuleByMats(representation.moduleMatrices,
                            coordinateData.field);
    socle := MTX.BasisSocle(module);
    return Length(socle) = coordinateData.dimension;
end;;

# Let Q_0 be the linear part of M/CT, put B_0=B cap Q_0, and let
# R=O_r(B_0).  The group B_0 is normal in B, and R is characteristic in
# B_0, so R is normal in B.  For every relevant L<=B, the group
# K=L cap Q_0 acts faithfully and completely reducibly on T/Z(T).  Hence
# O_r(K)=1 and L cap R=K cap R=1.  Thus L is a complement to R in the
# inverse image of its image in B/R.  The calculation below enumerates all
# such complements.  When there is no field automorphism, Q_0=Q and this
# is the usual descent through O_r(B).
MediumRowsDescentGroups := function(parent, data)
    local r, linearParent, radical, factorMap, factor, classes, coordinateData,
           retained, classNumber, factorGroup, inverseImage, complements,
           complement, linearComplement, preimage, scope;
    r := MediumRowsPrimePower(data.row.e).r;
    MediumRowsCheck("solvable parent in the descent",
                    IsSolvableGroup(parent), true);
    MediumRowsCheck("linear quotient is normal in the full quotient",
                    IsNormal(data.quotient, data.linearQuotientFactor), true);
    linearParent := Intersection(parent, data.linearQuotientFactor);
    MediumRowsCheck("linear part of a descent parent is normal",
                    IsNormal(parent, linearParent), true);
    radical := PCore(linearParent, r);
    if Size(radical) = 1 then
        Error("descent requires a nontrivial O_", r,
              " in the linear part of the parent");
    fi;
    MediumRowsCheck("the radical of the linear part is normal in its parent",
                    IsNormal(parent, radical), true);
    factorMap := NaturalHomomorphismByNormalSubgroup(parent, radical);
    factor := Image(factorMap);
    MediumRowsCheck("kernel of B -> B/R",
                    Kernel(factorMap), radical);
    classes := ConjugacyClassesSubgroups(factor);
    coordinateData := MediumRowsCoreQuotientCoordinates(data);
    retained := [];

    for classNumber in [1 .. Length(classes)] do
        factorGroup := Representative(classes[classNumber]);
        inverseImage := PreImage(factorMap, factorGroup);
        MediumRowsCheck("R lies in a factor preimage",
                        IsSubgroup(inverseImage, radical), true);
        MediumRowsCheck("image of a factor preimage",
                        Image(factorMap, inverseImage), factorGroup);
        complements := ComplementClassesRepresentatives(
                           inverseImage, radical);
        if complements = fail then
            Error("GAP did not compute the complement classes required for descent");
        fi;
        for complement in complements do
            MediumRowsCheck("a complement meets R trivially",
                Intersection(complement, radical), TrivialSubgroup(parent));
            MediumRowsCheck("a complement and R give its inverse image",
                Group(Concatenation(GeneratorsOfGroup(complement),
                                    GeneratorsOfGroup(radical))),
                inverseImage);
            MediumRowsCheck("image of a complement in the factor",
                            Image(factorMap, complement), factorGroup);
            linearComplement := Intersection(
                                    complement, data.linearQuotientFactor);
            MediumRowsCheck(
                "linear subgroup of a complement is normal",
                IsNormal(complement, linearComplement), true);
            if PCore(linearComplement, r)
                   = TrivialSubgroup(linearComplement)
               and MediumRowsFaithfulCompletelyReducibleOnCoreQuotient(
                       linearComplement, data, coordinateData) then
                preimage := PreImage(data.quotientMap, complement);
                MediumRowsCheck("solvable inverse image after descent",
                                IsSolvableGroup(preimage), true);
                scope := rec(quotientGroup := complement,
                             preimage := preimage,
                             quotientOrder := Size(complement));
                if MediumRowsScopeIsIrreducible(scope, data.baseField)
                   and not ForAny(retained, entry ->
                       IsConjugate(parent, entry.group, complement)) then
                    Add(retained,
                        rec(group := complement,
                            order := Size(complement)));
                fi;
            fi;
        od;
    od;

    return rec(radicalOrder := Size(radical),
               linearParentOrder := Size(linearParent),
               factorOrder := Size(factor),
               factorClassCount := Length(classes),
               groups := retained);
end;;

# Let Q_0 be the linear part of M/CT and let K_0 be the kernel of its action
# on T/Z(T).  This is the projective multiplicity factor and is normal in the
# full quotient.  If B is a parent subgroup, put N=B cap K_0.  Every subgroup
# relevant to the structural theorem has a linear part which acts faithfully
# on T/Z(T), and hence meets N trivially.  Such a subgroup is a complement to
# N in the inverse image of its image in B/N.  Enumerating all subgroup classes
# of B/N and all complement classes in their inverse images is exhaustive.
MediumRowsCoreKernelDescentGroups := function(parent, data)
    local r, coordinateData, linearRepresentation, linearKernel, kernel,
          factorMap, factor,
          classes, retained, classNumber, factorGroup, inverseImage,
          complements, complement, linearComplement, preimage, scope;
    r := MediumRowsPrimePower(data.row.e).r;
    MediumRowsCheck("solvable parent in the core-action-kernel descent",
                    IsSolvableGroup(parent), true);
    MediumRowsCheck("linear quotient is normal in the full quotient for the core-action-kernel descent",
                    IsNormal(data.quotient,
                             data.linearQuotientFactor), true);
    coordinateData := MediumRowsCoreQuotientCoordinates(data);
    linearRepresentation := MediumRowsCoreQuotientMatrixGroup(
                                data.linearQuotientFactor, data,
                                coordinateData);
    linearKernel := Kernel(linearRepresentation.map);
    MediumRowsCheck("order of the projective multiplicity kernel",
                    Size(linearKernel),
                    data.row.projectiveMultiplicityOrder);
    MediumRowsCheck("projective multiplicity kernel is normal in the full quotient",
                    IsNormal(data.quotient, linearKernel), true);
    kernel := Intersection(parent, linearKernel);
    if Size(kernel) = 1 then
        Error("the core-action-kernel descent requires a nontrivial intersection with the projective multiplicity kernel");
    fi;
    MediumRowsCheck("the core-action kernel is normal in its parent",
                    IsNormal(parent, kernel), true);
    factorMap := NaturalHomomorphismByNormalSubgroup(parent, kernel);
    factor := Image(factorMap);
    MediumRowsCheck("kernel of the map to the core-action factor",
                    Kernel(factorMap), kernel);
    classes := ConjugacyClassesSubgroups(factor);
    retained := [];

    for classNumber in [1 .. Length(classes)] do
        factorGroup := Representative(classes[classNumber]);
        inverseImage := PreImage(factorMap, factorGroup);
        MediumRowsCheck("the core-action kernel lies in a factor preimage",
                        IsSubgroup(inverseImage, kernel), true);
        MediumRowsCheck("image of a core-action factor preimage",
                        Image(factorMap, inverseImage), factorGroup);
        complements := ComplementClassesRepresentatives(
                           inverseImage, kernel);
        if complements = fail then
            Error("GAP did not compute the complement classes required for the core-action-kernel descent");
        fi;
        for complement in complements do
            MediumRowsCheck("a core-action-kernel complement meets the kernel trivially",
                Intersection(complement, kernel), TrivialSubgroup(parent));
            MediumRowsCheck("a core-action-kernel complement and the kernel give its inverse image",
                Group(Concatenation(GeneratorsOfGroup(complement),
                                    GeneratorsOfGroup(kernel))),
                inverseImage);
            MediumRowsCheck("image of a core-action-kernel complement",
                            Image(factorMap, complement), factorGroup);
            linearComplement := Intersection(
                                    complement,
                                    data.linearQuotientFactor);
            MediumRowsCheck(
                "linear subgroup of a core-action-kernel complement is normal",
                IsNormal(complement, linearComplement), true);
            MediumRowsCheck(
                "linear subgroup of a complement meets the projective multiplicity kernel trivially",
                Size(Intersection(linearComplement, linearKernel)), 1);
            if PCore(linearComplement, r)
                   = TrivialSubgroup(linearComplement)
               and MediumRowsFaithfulCompletelyReducibleOnCoreQuotient(
                       linearComplement, data, coordinateData) then
                preimage := PreImage(data.quotientMap, complement);
                MediumRowsCheck("solvable inverse image after the core-action-kernel descent",
                                IsSolvableGroup(preimage), true);
                scope := rec(quotientGroup := complement,
                             preimage := preimage,
                             quotientOrder := Size(complement));
                if MediumRowsScopeIsIrreducible(scope, data.baseField)
                   and not ForAny(retained, entry ->
                       IsConjugate(parent, entry.group, complement)) then
                    Add(retained,
                        rec(group := complement,
                            order := Size(complement)));
                fi;
            fi;
        od;
    od;

    return rec(parentOrder := Size(parent),
               linearKernel := linearKernel,
               kernel := kernel,
               coordinateData := coordinateData,
               kernelOrder := Size(kernel),
               factorOrder := Size(factor),
               factorClassCount := Length(classes),
               groups := retained);
end;;

MediumRowsKVectorToFVector := function(coordinates, data)
    local basis;
    basis := data.extensionBasis;
    return Concatenation(List(coordinates,
        coordinate -> Coefficients(basis, coordinate)));
end;;

MediumRowsFVectorToKVector := function(vector, data)
    local basis, degree, dimension, coordinates, coordinate, position,
          coefficients, i;
    basis := data.extensionBasis;
    degree := Length(basis);
    if Length(vector) mod degree <> 0 then
        Error("the prime-field vector has the wrong length");
    fi;
    dimension := QuoInt(Length(vector), degree);
    coordinates := [];
    for coordinate in [0 .. dimension - 1] do
        position := coordinate * degree + 1;
        coefficients := vector{[position .. position + degree - 1]};
        Add(coordinates,
            Sum([1 .. degree], i -> coefficients[i] * basis[i]));
    od;
    return coordinates;
end;;

# A projective point is stored as a single nonnegative integer.  In base q,
# digit 0 denotes the zero coordinate and digit 1+j denotes Z(q)^j.  The
# first nonzero coordinate of the canonical representative is therefore
# always represented by digit 1.
MediumRowsEncodeLine := function(coordinates, field)
    local canonical, code, place, coordinate, digit;
    canonical := MediumRowsCanonicalKVector(coordinates);
    code := 0;
    place := 1;
    for coordinate in canonical do
        if IsZero(coordinate) then
            digit := 0;
        else
            digit := 1 + LogFFE(coordinate, Z(Size(field)));
        fi;
        code := code + digit * place;
        place := place * Size(field);
    od;
    return code;
end;;

MediumRowsCoordinatesFromLineCode := function(code, dimension, field)
    local value, coordinates, digit;
    if code < 0 then
        Error("a projective-point code must be nonnegative");
    fi;
    value := code;
    coordinates := [];
    while Length(coordinates) < dimension do
        digit := value mod Size(field);
        value := QuoInt(value, Size(field));
        if digit = 0 then
            Add(coordinates, Zero(field));
        else
            Add(coordinates, Z(Size(field))^(digit - 1));
        fi;
    od;
    if value <> 0 then
        Error("a projective-point code has too many base-q digits");
    fi;
    return coordinates;
end;;

MediumRowsDecodeLine := function(code, dimension, field)
    local coordinates;
    coordinates := MediumRowsCoordinatesFromLineCode(
                       code, dimension, field);
    if ForAll(coordinates, IsZero) then
        Error("the zero vector is not a projective point");
    fi;
    MediumRowsCheck("canonical projective-point code",
        MediumRowsEncodeLine(coordinates, field), code);
    return coordinates;
end;;

MediumRowsImageOfLine := function(lineCode, matrix, data)
    local coordinates, vector, image, imageCoordinates;
    coordinates := MediumRowsCoordinatesFromLineCode(
        lineCode, data.row.e * data.row.b, data.extensionField);
    vector := MediumRowsKVectorToFVector(coordinates, data);
    image := vector * matrix;
    imageCoordinates := MediumRowsFVectorToKVector(image, data);
    return MediumRowsEncodeLine(imageCoordinates, data.extensionField);
end;;

MediumRowsCoreOrbit := function(lineCode, data)
    local target, queue, seen, head, generators, generator, imageCode;
    target := Size(data.core) / Size(data.scalarIntersection);
    queue := [lineCode];
    seen := NewDictionary(lineCode, false);
    AddDictionary(seen, lineCode);
    generators := Filtered(GeneratorsOfGroup(data.core),
        generator -> not generator in data.scalarIntersection);
    head := 1;
    while head <= Length(queue) do
        for generator in generators do
            imageCode := MediumRowsImageOfLine(
                             queue[head], generator, data);
            if not KnowsDictionary(seen, imageCode) then
                AddDictionary(seen, imageCode);
                Add(queue, imageCode);
                if Length(queue) > target then
                    Error("a core orbit exceeded |T:T cap C|");
                fi;
            fi;
        od;
        head := head + 1;
    od;
    return queue;
end;;


# A spanning tree of B is computed once.  The label on an edge records which
# lifted generator is to be applied to a line.  Thus testing a point needs at
# most |B| line images and stores no list of lifted matrices for the elements
# of B.
MediumRowsPrepareQuotientTree := function(quotientGroup, data)
    local quotientGenerators, generatorLifts, elements, parents, labels,
          positions, position, generatorPosition, nextElement;
    quotientGenerators := GeneratorsOfGroup(quotientGroup);
    generatorLifts := List(quotientGenerators,
        generator -> PreImagesRepresentative(data.quotientMap, generator));
    if fail in generatorLifts then
        Error("a quotient-subgroup generator has no lift to M");
    fi;
    MediumRowsCheck("quotient images of the lifted generators",
        ForAll([1 .. Length(quotientGenerators)], generatorPosition ->
            Image(data.quotientMap, generatorLifts[generatorPosition])
                = quotientGenerators[generatorPosition]), true);

    elements := [One(quotientGroup)];
    parents := [0];
    labels := [0];
    positions := NewDictionary(One(quotientGroup), true);
    AddDictionary(positions, elements[1], 1);
    position := 1;
    while position <= Length(elements) do
        for generatorPosition in [1 .. Length(quotientGenerators)] do
            nextElement := elements[position]
                           * quotientGenerators[generatorPosition];
            if LookupDictionary(positions, nextElement) = fail then
                Add(elements, nextElement);
                Add(parents, position);
                Add(labels, generatorPosition);
                AddDictionary(positions, nextElement, Length(elements));
            fi;
        od;
        position := position + 1;
    od;
    MediumRowsCheck("size of the quotient-subgroup spanning tree",
                    Length(elements), Size(quotientGroup));
    return rec(group := quotientGroup,
               order := Length(elements),
               parents := parents,
               labels := labels,
               generatorLifts := generatorLifts);
end;;

# Let B be a subgroup of M/CT and H its inverse image.  The H-stabiliser of a
# K-line is C precisely when the T-orbit of that line has length
# |T:T cap C| and the stabiliser in B of this T-orbit is trivial.  Along the
# spanning tree, pointImages[i] is the image under one lift of elements[i].
# The stabiliser is trivial exactly when only the identity image lies in the
# original T-orbit.
MediumRowsProjectiveIntersectionCount := function(scope, lineCode, data,
                                                   stopAt)
    local coreOrbit, coreTarget, coreOrbitSet, pointImages, count, position,
          imageCode;
    coreOrbit := MediumRowsCoreOrbit(lineCode, data);
    coreTarget := Size(data.core) / Size(data.scalarIntersection);
    if Length(coreOrbit) <> coreTarget then
        return rec(coreOrbitLength := Length(coreOrbit), count := 0);
    fi;
    coreOrbitSet := Set(coreOrbit);
    pointImages := [lineCode];
    count := 1;
    if scope.order > 1 then
        for position in [2 .. scope.order] do
            imageCode := MediumRowsImageOfLine(
                pointImages[scope.parents[position]],
                scope.generatorLifts[scope.labels[position]], data);
            Add(pointImages, imageCode);
            if imageCode in coreOrbitSet then
                count := count + 1;
                if stopAt <> fail and count >= stopAt then
                    return rec(coreOrbitLength := coreTarget,
                               count := count);
                fi;
            fi;
        od;
    fi;
    return rec(coreOrbitLength := coreTarget, count := count);
end;;

# Every inverse image considered below contains C.  Hence a K-line orbit of
# length |H:C| has line stabiliser C.  No nonidentity scalar fixes a nonzero
# vector on the line, so that vector has trivial stabiliser in H and in every
# subgroup of H.
MediumRowsPointWorks := function(scope, data, lineCode)
    local coreTarget, groupTarget, numberOfLines, result;
    # This checks that a stored code is nonzero and is the canonical code of
    # a K-line.  Codes produced during the orbit calculation inherit this
    # property and are decoded without repeating the check at every edge.
    MediumRowsDecodeLine(lineCode, data.row.e * data.row.b,
                         data.extensionField);
    numberOfLines :=
        (Size(data.extensionField)^(data.row.e * data.row.b) - 1)
        / (Size(data.extensionField) - 1);
    coreTarget := Size(data.core) / Size(data.scalarIntersection);
    groupTarget := coreTarget * scope.order;
    if groupTarget > numberOfLines then
        return false;
    fi;
    result := MediumRowsProjectiveIntersectionCount(
                  scope, lineCode, data, 2);
    return result.coreOrbitLength = coreTarget and result.count = 1;
end;;


MediumRowsVerifyDescent := function(parentScope, recordedDescent, data,
                                    name)
    local r, calculated, coordinateData, recordedGroups, entry, group,
          linearGroup, generators, preimage, scope, tree;
    r := MediumRowsPrimePower(data.row.e).r;
    calculated := MediumRowsDescentGroups(
                      parentScope.quotientGroup, data);
    MediumRowsCheck(Concatenation("order of B_0 in ", name),
                    calculated.linearParentOrder,
                    recordedDescent.linearParentOrder);
    MediumRowsCheck(Concatenation("order of R in ", name),
                    calculated.radicalOrder,
                    recordedDescent.radicalOrder);
    MediumRowsCheck(Concatenation("factor order after descent in ", name),
                    calculated.factorOrder,
                    recordedDescent.factorOrder);
    MediumRowsCheck(Concatenation("factor subgroup classes in ", name),
                    calculated.factorClassCount,
                    recordedDescent.factorClassCount);
    coordinateData := MediumRowsCoreQuotientCoordinates(data);
    recordedGroups := [];
    for entry in recordedDescent.groups do
        generators := ShallowCopy(entry.generators);
        MediumRowsCheck("recorded descent generators lie in their parent",
            ForAll(generators, generator ->
                generator in parentScope.quotientGroup), true);
        if Length(generators) = 0 then
            group := TrivialSubgroup(parentScope.quotientGroup);
        else
            group := Group(generators);
        fi;
        MediumRowsCheck("a recorded descent subgroup lies in its parent",
            IsSubgroup(parentScope.quotientGroup, group), true);
        MediumRowsCheck("order of a recorded descent subgroup",
                        Size(group), entry.order);
        linearGroup := Intersection(group, data.linearQuotientFactor);
        MediumRowsCheck("recorded linear subgroup is normal",
                        IsNormal(group, linearGroup), true);
        MediumRowsCheck("trivial core in the linear subgroup after descent",
                        PCore(linearGroup, r), TrivialSubgroup(linearGroup));
        MediumRowsCheck("faithful completely reducible action of the linear subgroup after descent",
            MediumRowsFaithfulCompletelyReducibleOnCoreQuotient(
                linearGroup, data, coordinateData), true);
        preimage := PreImage(data.quotientMap, group);
        MediumRowsCheck("recorded inverse image after descent is solvable",
                        IsSolvableGroup(preimage), true);
        scope := rec(quotientGroup := group,
                     preimage := preimage,
                     quotientOrder := Size(group));
        MediumRowsCheck("irreducible inverse image after descent",
            MediumRowsScopeIsIrreducible(scope, data.baseField), true);
        tree := MediumRowsPrepareQuotientTree(group, data);
        MediumRowsCheck("recorded projective point after descent",
            MediumRowsPointWorks(tree, data, entry.projectivePoint), true);
        Add(recordedGroups, group);
    od;
    MediumRowsCheckConjugacyBijection(
        parentScope.quotientGroup,
        recordedGroups,
        List(calculated.groups, record -> record.group));
end;;


MediumRowsVerifyCoreKernelDescent := function(parentScope, recordedDescent,
                                              data, name)
    local r, calculated, coordinateData, linearKernel, kernel,
          recordedGroups, entry, generators, group, linearGroup,
          preimage, scope, tree;
    r := MediumRowsPrimePower(data.row.e).r;
    calculated := MediumRowsCoreKernelDescentGroups(
                      parentScope.quotientGroup, data);
    MediumRowsCheck(Concatenation("parent order in the core-action-kernel descent for ", name),
                    calculated.parentOrder,
                    recordedDescent.parentOrder);
    MediumRowsCheck(Concatenation("kernel order in the core-action-kernel descent for ", name),
                    calculated.kernelOrder,
                    recordedDescent.kernelOrder);
    MediumRowsCheck(Concatenation("factor order in the core-action-kernel descent for ", name),
                    calculated.factorOrder,
                    recordedDescent.factorOrder);
    MediumRowsCheck(Concatenation("factor subgroup classes in the core-action-kernel descent for ", name),
                    calculated.factorClassCount,
                    recordedDescent.factorClassCount);
    coordinateData := calculated.coordinateData;
    linearKernel := calculated.linearKernel;
    kernel := calculated.kernel;
    MediumRowsCheck("recomputed kernel order in the core-action-kernel descent",
                    Size(kernel), calculated.kernelOrder);
    recordedGroups := [];
    for entry in recordedDescent.groups do
        generators := ShallowCopy(entry.generators);
        MediumRowsCheck("recorded core-action-kernel descent generators lie in their parent",
            ForAll(generators, generator ->
                generator in parentScope.quotientGroup), true);
        if Length(generators) = 0 then
            group := TrivialSubgroup(parentScope.quotientGroup);
        else
            group := Group(generators);
        fi;
        MediumRowsCheck("a recorded core-action-kernel descent subgroup lies in its parent",
            IsSubgroup(parentScope.quotientGroup, group), true);
        MediumRowsCheck("order of a recorded core-action-kernel descent subgroup",
                        Size(group), entry.order);
        MediumRowsCheck("a recorded core-action-kernel descent subgroup meets the kernel trivially",
                        Intersection(group, kernel),
                        TrivialSubgroup(parentScope.quotientGroup));
        linearGroup := Intersection(group, data.linearQuotientFactor);
        MediumRowsCheck("linear subgroup after the core-action-kernel descent is normal",
                        IsNormal(group, linearGroup), true);
        MediumRowsCheck("linear subgroup after the core-action-kernel descent meets the projective multiplicity kernel trivially",
                        Size(Intersection(linearGroup, linearKernel)), 1);
        MediumRowsCheck("trivial core after the core-action-kernel descent",
                        PCore(linearGroup, r),
                        TrivialSubgroup(linearGroup));
        MediumRowsCheck("faithful completely reducible action after the core-action-kernel descent",
            MediumRowsFaithfulCompletelyReducibleOnCoreQuotient(
                linearGroup, data, coordinateData), true);
        preimage := PreImage(data.quotientMap, group);
        MediumRowsCheck("recorded inverse image after the core-action-kernel descent is solvable",
                        IsSolvableGroup(preimage), true);
        scope := rec(quotientGroup := group,
                     preimage := preimage,
                     quotientOrder := Size(group));
        MediumRowsCheck("irreducible inverse image after the core-action-kernel descent",
            MediumRowsScopeIsIrreducible(scope, data.baseField), true);
        tree := MediumRowsPrepareQuotientTree(group, data);
        MediumRowsCheck("recorded projective point after the core-action-kernel descent",
            MediumRowsPointWorks(tree, data, entry.projectivePoint), true);
        Add(recordedGroups, group);
    od;
    MediumRowsCheckConjugacyBijection(
        parentScope.quotientGroup,
        recordedGroups,
        List(calculated.groups, record -> record.group));
end;;

MediumRowsBaseRows := [
    rec(row:=4,   p:=7,  a:=1, e:=9, b:=1),
    rec(row:=5,   p:=13, a:=1, e:=9, b:=1),
    rec(row:=6,   p:=2,  a:=4, e:=9, b:=1),
    rec(row:=7,   p:=19, a:=1, e:=9, b:=1),
    rec(row:=8,   p:=5,  a:=2, e:=9, b:=1),
    rec(row:=11,  p:=7,  a:=1, e:=8, b:=1),
    rec(row:=12,  p:=3,  a:=2, e:=8, b:=1),
    rec(row:=13,  p:=11, a:=1, e:=8, b:=1),
    rec(row:=14,  p:=13, a:=1, e:=8, b:=1),
    rec(row:=15,  p:=17, a:=1, e:=8, b:=1),
    rec(row:=16,  p:=19, a:=1, e:=8, b:=1),
    rec(row:=17,  p:=5,  a:=2, e:=8, b:=1),
    rec(row:=119, p:=7,  a:=1, e:=4, b:=2),
    rec(row:=121, p:=3,  a:=1, e:=4, b:=3),
    rec(row:=123, p:=3,  a:=2, e:=4, b:=2),
    rec(row:=124, p:=3,  a:=1, e:=8, b:=2),
    rec(row:=127, p:=2,  a:=2, e:=9, b:=2)
];;

MediumRowsCheck("number of medium rows", Length(MediumRowsBaseRows), 17);
MediumRowsCheck("set of medium rows",
    Set(List(MediumRowsBaseRows, row -> row.row)),
    [4,5,6,7,8,11,12,13,14,15,16,17,119,121,123,124,127]);

MediumRowsKinds := function(row)
    local q;
    q := row.p^row.a;
    if row.e = 9 then
        return ["E3"];
    elif q mod 4 = 1 then
        return ["S"];
    fi;
    return ["E+", "E-"];
end;;

MediumRowsCompleteBranch := function(baseRow, kind)
    local row, q, projectiveMultiplicityOrder;
    row := ShallowCopy(baseRow);
    row.kind := kind;
    q := row.p^row.a;
    if row.e = 9 then
        MediumRowsCheck("core kind for e=9", kind, "E3");
        MediumRowsCheck("third roots of unity for e=9", (q - 1) mod 3, 0);
        row.coreOrder := 243;
        row.scalarIntersectionOrder := 3;
        row.fixedAutomorphismOrder := 4199040;
        row.classicalQuotientOrder := 51840;
    elif row.e = 8 then
        if kind = "S" then
            MediumRowsCheck("fourth roots of unity for S", (q - 1) mod 4, 0);
            row.coreOrder := 256;
            row.scalarIntersectionOrder := 4;
            row.fixedAutomorphismOrder := 92897280;
            row.classicalQuotientOrder := 1451520;
        elif kind = "E+" then
            MediumRowsCheck("separate extraspecial branches", q mod 4, 3);
            row.coreOrder := 128;
            row.scalarIntersectionOrder := 2;
            row.fixedAutomorphismOrder := 2580480;
            row.classicalQuotientOrder := 40320;
        else
            MediumRowsCheck("binary core kind", kind, "E-");
            MediumRowsCheck("separate extraspecial branches", q mod 4, 3);
            row.coreOrder := 128;
            row.scalarIntersectionOrder := 2;
            row.fixedAutomorphismOrder := 3317760;
            row.classicalQuotientOrder := 51840;
        fi;
    else
        MediumRowsCheck("remaining core degree", row.e, 4);
        if kind = "S" then
            MediumRowsCheck("fourth roots of unity for S", (q - 1) mod 4, 0);
            row.coreOrder := 64;
            row.scalarIntersectionOrder := 4;
            row.fixedAutomorphismOrder := 11520;
            row.classicalQuotientOrder := 720;
        elif kind = "E+" then
            MediumRowsCheck("separate extraspecial branches", q mod 4, 3);
            row.coreOrder := 32;
            row.scalarIntersectionOrder := 2;
            row.fixedAutomorphismOrder := 1152;
            row.classicalQuotientOrder := 72;
        else
            MediumRowsCheck("binary core kind", kind, "E-");
            MediumRowsCheck("separate extraspecial branches", q mod 4, 3);
            row.coreOrder := 32;
            row.scalarIntersectionOrder := 2;
            row.fixedAutomorphismOrder := 1920;
            row.classicalQuotientOrder := 120;
        fi;
    fi;
    projectiveMultiplicityOrder := Size(GL(row.b, q)) / (q - 1);
    row.projectiveMultiplicityOrder := projectiveMultiplicityOrder;
    row.quotientOrder := row.a * row.classicalQuotientOrder
                         * projectiveMultiplicityOrder;
    return row;
end;;

MediumRowsCalculations := [];;
for MediumRowsBaseRow in MediumRowsBaseRows do
    for MediumRowsKind in MediumRowsKinds(MediumRowsBaseRow) do
        Add(MediumRowsCalculations,
            MediumRowsCompleteBranch(MediumRowsBaseRow, MediumRowsKind));
    od;
od;

MediumRowsExpectedQuotients := [
    [4,"E3",51840], [5,"E3",51840], [6,"E3",207360],
    [7,"E3",51840], [8,"E3",103680],
    [11,"E+",40320], [11,"E-",51840], [12,"S",2903040],
    [13,"E+",40320], [13,"E-",51840], [14,"S",1451520],
    [15,"S",1451520], [16,"E+",40320], [16,"E-",51840],
    [17,"S",2903040], [119,"E+",24192], [119,"E-",40320],
    [121,"E+",404352], [121,"E-",673920], [123,"S",1036800],
    [124,"E+",967680], [124,"E-",1244160], [127,"E3",6220800]
];;
MediumRowsCheck("number of row-and-core calculations",
                Length(MediumRowsCalculations), 23);
MediumRowsCheck("orders of all quotients M/CT",
    Set(List(MediumRowsCalculations,
             row -> [row.row, row.kind, row.quotientOrder])),
    Set(MediumRowsExpectedQuotients));

# Each component inserted here records the degree of the fixed quotient
# action and every maximal-solvable reference subgroup in that action.  A
# subgroup is stored by exact permutation generators, its order, whether its
# inverse image is irreducible, and, in the irreducible case, either one
# projective point or the complete complement data described above.
MediumRowsRecordedData := rec();;

MediumRowsRecordedData.r4_E3 := rec(actionDegree:=83, groups:=[ rec(
generators := [ ( 1,28,37,10)( 2,31,39,16)( 3,34,38,13)( 4,30,43,11)( 5,33,45,17)( 6,36,44,14)( 7,29,40,12)( 8,32,42,18)( 9,35,41,15)(19,55,46,64)(20,58,48,70)(21,61,47,67)(22,57,52,65)(23,60,54,71)(24,63,53,68)(25,56,49,66)(26,59,51,72)(27,62,50,69)(74,76,75,79)(77,78,81,80), ( 1,60,72,53,37,71,59,24)( 2,54, 4, 6,39,23,43,44)( 3,12,47,64,38,29,21,55)( 5,81,61,57,45,77,67,65)( 7,33,15,74,40,17,35,75)( 8,27,28,36,42,50,10,14)( 9,66,80,13,41,56,78,34)(11,62,51,58,30,69,26,70)(16,68,32,48,31,63,18,20)(19,49,52,79,46,25,22,76), ( 1,37)( 2,39)( 3,38)( 4,43)( 5,45)( 6,44)( 7,40)( 8,42)( 9,41)(10,28)(11,30)(12,29)(13,34)(14,36)(15,35)(16,31)(17,33)(18,32)(19,46)(20,48)(21,47)(22,52)(23,54)(24,53)(25,49)(26,51)(27,50)(55,64)(56,66)(57,65)(58,70)(59,72)(60,71)(61,67)(62,69)(63,68)(74,75)(76,79)(77,81)(78,80) ],
