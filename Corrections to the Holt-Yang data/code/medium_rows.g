order := 31104 ), rec(
generators := [ ( 2,12,67,32, 4,34,47,14)( 3,20,52,63, 7,58,66,27)( 5,45)( 6,53,71,64, 8,69,51,46)( 9,77)(10,78,17,35,28,80,33,15)(11,59,74,57,31,23,76,25)(13,21,36,39,29,61,18,43)(16,54,79,49,30,72,75,65)(19,44,24,60,55,42,62,26)(22,68,40,70,56,50,38,48)(41,81)(82,83,84,85)(87,88), ( 1,37)( 2,16,40,48,81,59)( 3,67,79,29,41,27)( 4,57,45,14,74,52)( 5,36,75,22,43,65)( 7,20,77,72,39,31)( 8,80)( 9,50,38,61,76,12)(10,60,62,46,51,17)(11,30)(13,23)(15,53,55)(18,70)(19,26,33,28,71,69)(21,47)(24,64,35)(25,63)(32,58)(34,54)(42,78)(49,68)(56,66), (82,83)(84,85), ( 1,37)( 2,39)( 3,38)( 4,43)( 5,45)( 6,44)( 7,40)( 8,42)( 9,41)(10,28)(11,30)(12,29)(13,34)(14,36)(15,35)(16,31)(17,33)(18,32)(19,46)(20,48)(21,47)(22,52)(23,54)(24,53)(25,49)(26,51)(27,50)(55,64)(56,66)(57,65)(58,70)(59,72)(60,71)(61,67)(62,69)(63,68)(74,75)(76,79)(77,81)(78,80)(83,85,84) ],
irreducible := false,
order := 31104 ) ]);

MediumRowsCompleted := 0;;

for MediumRowsRow in MediumRowsCalculations do
    Print("row ", MediumRowsRow.row, " ", MediumRowsRow.kind,
          ": constructing M and its faithful quotient by CT\n");
    MediumRowsData := MediumRowsSemilinearNormaliser(MediumRowsRow);

    MediumRowsTestCoordinates :=
        ListWithIdenticalEntries(MediumRowsRow.e * MediumRowsRow.b,
                                 Zero(MediumRowsData.extensionField));
    MediumRowsTestCoordinates[1] := One(MediumRowsData.extensionField);
    if Length(MediumRowsTestCoordinates) > 1 then
        MediumRowsTestCoordinates[2] :=
            Z(Size(MediumRowsData.extensionField));
    fi;
    MediumRowsTestVector := MediumRowsKVectorToFVector(
                                MediumRowsTestCoordinates,
                                MediumRowsData);
    MediumRowsCheck("coordinate conversion after restriction of scalars",
        MediumRowsFVectorToKVector(MediumRowsTestVector, MediumRowsData),
        MediumRowsTestCoordinates);
    MediumRowsTestCode := MediumRowsEncodeLine(
        MediumRowsTestCoordinates, MediumRowsData.extensionField);
    MediumRowsCheck("integer projective-point encoding",
        MediumRowsDecodeLine(
            MediumRowsTestCode, MediumRowsRow.e * MediumRowsRow.b,
            MediumRowsData.extensionField),
        MediumRowsCanonicalKVector(MediumRowsTestCoordinates));

    MediumRowsKey := Concatenation(
        "r", String(MediumRowsRow.row), "_",
        ReplacedString(ReplacedString(MediumRowsRow.kind, "+", "p"),
                       "-", "m"));
    if not IsBound(MediumRowsRecordedData.(MediumRowsKey)) then
        Error("no data have been recorded for ", MediumRowsKey);
    fi;

    MediumRowsFreshQuotientGroups :=
        MediumRowsMaximalSolvableQuotientGroups(MediumRowsData.quotient);
    MediumRowsMaximalOrders :=
        SortedList(List(MediumRowsFreshQuotientGroups, Size));
    MediumRowsRowData := MediumRowsRecordedData.(MediumRowsKey);
    MediumRowsScopeRecords := MediumRowsReferenceScopes(
        MediumRowsRowData, MediumRowsData);
    MediumRowsCheckConjugacyBijection(
        MediumRowsData.quotient,
        List(MediumRowsScopeRecords, scope -> scope.quotientGroup),
        MediumRowsFreshQuotientGroups);

    SortBy(MediumRowsScopeRecords, scope -> scope.quotientOrder);
    for MediumRowsScope in MediumRowsScopeRecords do
        MediumRowsScope.isIrreducible := MediumRowsScopeIsIrreducible(
            MediumRowsScope, MediumRowsData.baseField);
    od;
    MediumRowsIrreducibleScopes := Filtered(
        MediumRowsScopeRecords, scope -> scope.isIrreducible);
    MediumRowsIrreducibleOrders :=
        SortedList(List(MediumRowsIrreducibleScopes,
                        scope -> scope.quotientOrder));
    Print("  maximal-solvable quotient orders ",
          MediumRowsMaximalOrders, "\n");
    Print("  irreducible inverse-image quotient orders ",
          MediumRowsIrreducibleOrders, "\n");

    MediumRowsCovered := 0;
    for MediumRowsScope in MediumRowsScopeRecords do
        MediumRowsEntry := MediumRowsScope.recordedEntry;
        MediumRowsCheck(Concatenation(
            "recorded irreducibility for ", MediumRowsKey),
            MediumRowsEntry.irreducible,
            MediumRowsScope.isIrreducible);

        if not MediumRowsScope.isIrreducible then
            if IsBound(MediumRowsEntry.projectivePoint) or
               IsBound(MediumRowsEntry.descent) or
               IsBound(MediumRowsEntry.coreKernelDescent) then
                Error("a reducible reference subgroup has point or complement ",
                      "data in ", MediumRowsKey);
            fi;
            continue;
        fi;

        if not IsBound(MediumRowsEntry.projectivePoint) then
            Error("an irreducible reference subgroup has no ",
                  "projective-point field in ", MediumRowsKey);
        fi;
        if MediumRowsEntry.projectivePoint = fail then
            if IsBound(MediumRowsEntry.descent) =
               IsBound(MediumRowsEntry.coreKernelDescent) then
                Error("an irreducible reference subgroup without a point ",
                      "must have exactly one complement calculation in ",
                      MediumRowsKey);
            fi;
            if IsBound(MediumRowsEntry.descent) then
                MediumRowsVerifyDescent(
                    MediumRowsScope, MediumRowsEntry.descent,
                    MediumRowsData, MediumRowsKey);
            else
                MediumRowsVerifyCoreKernelDescent(
                    MediumRowsScope,
                    MediumRowsEntry.coreKernelDescent,
                    MediumRowsData, MediumRowsKey);
            fi;
            MediumRowsCovered := MediumRowsCovered + 1;
            continue;
        fi;
        if IsBound(MediumRowsEntry.descent) or
           IsBound(MediumRowsEntry.coreKernelDescent) then
            Error("complement data accompany an unnecessary point in ",
                  MediumRowsKey);
        fi;

        MediumRowsTree := MediumRowsPrepareQuotientTree(
                              MediumRowsScope.quotientGroup,
                              MediumRowsData);
        MediumRowsCheck("order recorded by the quotient-subgroup tree",
                        MediumRowsTree.order,
                        MediumRowsScope.quotientOrder);
        MediumRowsCheck(Concatenation(
            "recorded projective point for ", MediumRowsKey),
            MediumRowsPointWorks(MediumRowsTree, MediumRowsData,
                                 MediumRowsEntry.projectivePoint),
            true);
        MediumRowsCovered := MediumRowsCovered + 1;
    od;

    MediumRowsCheck(Concatenation(
        "all irreducible inverse images are covered for ", MediumRowsKey),
        MediumRowsCovered, Length(MediumRowsIrreducibleScopes));
    MediumRowsCompleted := MediumRowsCompleted + 1;
od;

MediumRowsCheck("completed row-and-core calculations", MediumRowsCompleted,
                Length(MediumRowsCalculations));
Print("The seventeen medium rows are complete; every relevant ",
      "subgroup lies in a checked inverse image with a regular ",
      "orbit.\n");

QUIT_GAP(0);
